# Canonical site URL used for auth redirects when available, e.g. https://store.example.com
NEXT_PUBLIC_SITE_URL=

# Public Supabase URL used by the browser
NEXT_PUBLIC_SUPABASE_URL=
# Public Supabase publishable key. Safe for browser use when RLS is configured correctly.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key. Add ONLY in Vercel Environment Variables.
# Never expose this with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SECRET_KEY=

# Optional Sentry DSN overrides.
# The project has a public DSN fallback in code, so these are only needed if you
# want to override it per environment. A browser DSN is intentionally public.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Optional build-time source-map upload configuration.
# Keep SENTRY_AUTH_TOKEN server/build-only.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
