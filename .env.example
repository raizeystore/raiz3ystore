# Public Supabase URL used by the browser
NEXT_PUBLIC_SUPABASE_URL=
# Public Supabase publishable key. Safe for browser use when RLS is configured correctly.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key. Add ONLY in Vercel Environment Variables.
# Never expose this with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SECRET_KEY=

# Optional Sentry monitoring. Monitoring stays disabled when DSN values are blank.
# The browser DSN is intentionally public; never put an auth token in NEXT_PUBLIC_.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Optional build-time source-map upload configuration.
# Keep SENTRY_AUTH_TOKEN server/build-only.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
