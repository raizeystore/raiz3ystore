# Public Supabase URL used by the browser
NEXT_PUBLIC_SUPABASE_URL=
# Public Supabase publishable/anon key. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets go here locally and must be added to Vercel/Supabase secrets.
# SUPABASE_SERVICE_ROLE_KEY=
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
